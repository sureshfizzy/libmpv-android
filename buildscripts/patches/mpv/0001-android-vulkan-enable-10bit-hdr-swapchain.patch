diff --git a/video/out/vulkan/context_android.c b/video/out/vulkan/context_android.c
index 512830d..5f2c4a5 100644
--- a/video/out/vulkan/context_android.c
+++ b/video/out/vulkan/context_android.c
@@ -27,6 +27,9 @@ struct priv {
     struct mpvk_ctx vk;
 };
 
+// AHARDWAREBUFFER_FORMAT_R10G10B10A2_UNORM / WINDOW_FORMAT_RGBA_1010102
+#define WINDOW_FORMAT_10BIT 43
+
 static void android_uninit(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
@@ -48,6 +51,11 @@ static bool android_init(struct ra_ctx *ctx)
     if (!mpvk_init(vk, ctx, VK_KHR_ANDROID_SURFACE_EXTENSION_NAME))
         goto fail;
 
+    // Set 10-bit buffer format on the native window before creating the
+    // Vulkan surface. This signals the compositor to expose HDR-capable
+    // color spaces in vkGetPhysicalDeviceSurfaceFormatsKHR.
+    ANativeWindow_setBuffersGeometry(vo_android_native_window(ctx->vo), 0, 0, WINDOW_FORMAT_10BIT);
+
     VkAndroidSurfaceCreateInfoKHR info = {
          .sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR,
          .window = vo_android_native_window(ctx->vo)
@@ -80,8 +88,9 @@ static bool android_reconfig(struct ra_ctx *ctx)
     // Update window geometry to prevent screen tearing
     ANativeWindow *native_window = vo_android_native_window(ctx->vo);
     if (native_window) {
-        int32_t current_format = ANativeWindow_getFormat(native_window);
-        ANativeWindow_setBuffersGeometry(native_window, w, h, current_format);
+        // Pass 0 as format to avoid overriding the Vulkan swapchain's
+        // chosen format (which may be 10-bit for HDR content).
+        ANativeWindow_setBuffersGeometry(native_window, w, h, 0);
     }
 
     ra_vk_ctx_resize(ctx, w, h);
